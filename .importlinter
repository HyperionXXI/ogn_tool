[importlinter]
root_package = ogn_tool

[importlinter:contract:no_pipeline_to_analysis]
name = Pipeline must not depend on analysis
type = forbidden
allow_indirect_imports = True
source_modules =
    ogn_tool.pipeline
forbidden_modules =
    ogn_tool.analysis

[importlinter:contract:no_reporting_to_analysis]
name = Reporting must not depend on analysis
type = forbidden
allow_indirect_imports = True
source_modules =
    ogn_tool.reporting
forbidden_modules =
    ogn_tool.analysis

[importlinter:contract:no_runtime_to_analysis]
name = Runtime must not depend on analysis
type = forbidden
allow_indirect_imports = True
source_modules =
    ogn_tool.runtime
forbidden_modules =
    ogn_tool.analysis

[importlinter:contract:no_domain_to_kernel]
name = Domain must not depend on kernel
type = forbidden
allow_indirect_imports = True
source_modules =
    ogn_tool.domain
forbidden_modules =
    ogn_tool.kernel
